{
  "extends": "./frontend-paths.generated.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["vite/client"]
  },
  "files": [
    "globals.d.ts",
    "auto-imports.d.ts",
    "frontend-modules.generated.ts"
  ],
  "include": ["frontend-modules/**/*.ts", "frontend-modules/**/*.vue"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/vitest.config.ts",
    "**/eslint.config.*"
  ]
}
