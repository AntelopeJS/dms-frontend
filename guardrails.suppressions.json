{
  "rules": {
    "anti-slop/no-unknown-parameters": 7,
    "anti-slop/no-unknown-returns": 1,
    "typescript/no-unsafe-assignment": 6,
    "typescript/no-unsafe-return": 4
  },
  "tsExpectError": 10,
  "tsIgnore": 0,
  "safety": 13,
  "config": {
    "eslint/max-lines for tests/**/*.test.mts": 1,
    "eslint/max-lines for tests/**/*.test.ts": 1,
    "eslint/max-lines-per-function for tests/**/*.test.mts": 1,
    "eslint/max-lines-per-function for tests/**/*.test.ts": 1,
    "typescript/no-floating-promises for tests/**/*.test.mts": 1,
    "typescript/no-floating-promises for tests/**/*.test.ts": 1
  }
}
