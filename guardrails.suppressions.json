{
  "rules": {
    "anti-slop/no-unknown-parameters": 5,
    "anti-slop/no-unknown-returns": 1,
    "typescript/no-unsafe-assignment": 0,
    "typescript/no-unsafe-return": 0
  },
  "tsExpectError": 0,
  "tsIgnore": 0,
  "safety": 8,
  "config": {
    "eslint/max-lines for tests/**/*.test.mts": 0,
    "eslint/max-lines for tests/**/*.test.ts": 0,
    "eslint/max-lines-per-function for tests/**/*.test.mts": 0,
    "eslint/max-lines-per-function for tests/**/*.test.ts": 0,
    "typescript/no-floating-promises for tests/**/*.test.mts": 0,
    "typescript/no-floating-promises for tests/**/*.test.ts": 0
  },
  "agentFiles": true
}
