{
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "target": "ES2021",
    "module": "preserve",
    "lib": ["ES2021"],
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts"]
}
