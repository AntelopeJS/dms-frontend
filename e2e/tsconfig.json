{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "incremental": false
  },
  "include": ["*.ts", "**/*.mjs"],
  "exclude": ["playwright-report", "test-results", "blob-report"]
}
