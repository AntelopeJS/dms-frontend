{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "node_modules/.cache/templates-config",
    "tsBuildInfoFile": "node_modules/.cache/templates-config/.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "checkJs": true
  },
  "include": ["./templates/vue/**/*.mjs"]
}
