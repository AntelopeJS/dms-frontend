{
  "name": "@antelopejs/dms-frontend",
  "version": "0.7.1",
  "description": "Frontend-agnostic loader for AntelopeJS DMS, shipping the Vue 3 renderer (Vite, Inertia, SSR)",
  "keywords": [
    "antelope",
    "antelopejs",
    "dms",
    "frontend",
    "frontend-modules",
    "inertia",
    "loader",
    "renderer",
    "ui",
    "vite",
    "vue"
  ],
  "homepage": "https://dms.antelopejs.com/docs/frontend",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-frontend/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-frontend.git"
  },
  "bin": {
    "ajs-dms": "./dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "templates/",
    "skills/"
  ],
  "main": "./dist/common.js",
  "types": "./dist/common.d.ts",
  "exports": {
    ".": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": "./dist/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run build && pnpm run test && release-it",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "test:real-source": "pnpm run build && node dist/verify-source-runner.js",
    "format": "oxfmt .",
    "lint": "oxlint && oxfmt --check . && antelopejs-check-interface-ranges && pnpm run docs:reference:check",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt .",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "docs:reference": "tsx scripts/docs-reference.ts",
    "docs:reference:check": "tsx scripts/docs-reference.ts --check"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "ignore": "^7.0.5",
    "semver": "^7.7.4",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/tooling-configs": ">=0.0.9 <1.0.0",
    "@iconify/utils": "^3.1.0",
    "@iconify/vue": "^5.0.1",
    "@inertiajs/vue3": "^3.7.1",
    "@types/node": "^24.8.1",
    "@types/semver": "^7.7.1",
    "@types/unzipper": "^0.10.11",
    "@unhead/vue": "^2.1.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "^3.5.25",
    "@vueuse/core": "14.4.0",
    "defu": "^6.1.4",
    "devalue": "^5.9.4",
    "knip": "^6.34.0",
    "ofetch": "^1.5.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^20.2.0",
    "vite": "^8.3.4",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.7"
  },
  "peerDependencies": {
    "@antelopejs/core": ">=1.16.0 <2"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "^0.95.0",
    "@oxc-parser/binding-darwin-x64": "^0.95.0",
    "@oxc-parser/binding-linux-arm64-gnu": "^0.95.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.95.0",
    "@oxc-parser/binding-win32-x64-msvc": "^0.95.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "patchedDependencies": {
      "@vueuse/core@14.4.0": "templates/vue/patches/@vueuse__core@14.4.0.patch"
    }
  },
  "antelopeJs": {
    "skills": [
      "./skills"
    ]
  }
}
