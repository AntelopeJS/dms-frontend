{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "lib": ["ES2021", "DOM"],
    "skipLibCheck": true,
    "module": "esnext",
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "./**/*.mts"]
}
