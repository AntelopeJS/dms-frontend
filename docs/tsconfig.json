{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
