{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@antelopejs/dms-frontend/templates/*": ["../templates/*"]
    },
    "lib": ["ES2022", "DOM"]
  },
  "include": ["./**/*.ts"]
}
